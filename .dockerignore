# Keep the build context small and never leak local state/secrets into the image.
# The Dockerfile copies an explicit allowlist of files, but excluding here also
# speeds the context upload and guards against accidental `COPY .` in future.

.git
.github
.gitignore
venv/
__pycache__/
*.pyc

# Local runtime state / secrets (config.ini holds the inverter IP + hashed password)
config.ini
*.db
*.db.*
dashboard.log
backups/
quick_action_state.json

# Tests, tooling, docs, build outputs, website — not needed at runtime
tests/
tools/
reference/
website/
Output/
images/
*.md
serve.py
index.html
givenergy-api-docs.html
catalogue.json
build_catalogue.py
build_local_docs.py
generate_icons.py
givenergy_probe.py
test_nearest.py
test_steve.py
